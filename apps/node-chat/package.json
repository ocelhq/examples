{
  "name": "node-chat",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/client.ts --bundle --format=esm --outfile=dist/app.js",
    "dev": "pnpm build && tsx src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "hono": "^4.6.0",
    "ocel": "0.0.4",
    "pg": "^8.22.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/pg": "^8.11.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
